<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/assets/css/infographic-seven-to-zero.css">
<div class="n3l-infographic">
<figure class="fig">

  <header class="mast">
    <div class="brandline">
      <span class="brand">NEXT3LABS</span>
      <span class="tag">Oct 2024 &ndash; Present</span>
    </div>
    <h1>Seven offshore developers&nbsp;<span class="to-zero">to&nbsp;zero.</span></h1>
    <p class="sub"><strong>And we got faster.</strong></p>
    <div class="mast-rule"></div>
  </header>

  <div class="heroes">

    <section class="hero">
      <span class="eyebrow label">Offshore developers</span>
      <div class="seq num">
        <span class="from">7</span>
        <span class="arrow">&rarr;</span>
        <span class="to">0</span>
      </div>
      <p class="caption">Seven offshore developers to zero, in <b>16 months</b>.</p>
    </section>

    <section class="hero">
      <span class="eyebrow label">Fixes &amp; changes</span>
      <div class="multi num">
        <span class="val">5&ndash;7</span>
        <span class="x">&times;</span>
      </div>
      <p class="caption"><b>Faster</b> on fixes and changes than the team it replaced.</p>
      <div class="bars" aria-hidden="true">
        <div class="bar-row">
          <span class="key">Then</span>
          <span class="track"><i class="then"></i></span>
        </div>
        <div class="bar-row">
          <span class="key">Now</span>
          <span class="track"><i class="now"></i></span>
        </div>
      </div>
    </section>

  </div>

  <section class="support">
    <div class="support-head">
      <span class="eyebrow">What held, or improved</span>
      <span class="note">Fewer people. Not fewer standards.</span>
    </div>

    <div class="grid3">

      <div class="cell">
        <div class="figure">
          <span class="num">3</span>
          <span class="unit">Cap</span>
        </div>
        <h3>Concurrent developments</h3>
        <p>Deliberately capped &mdash; a quality ceiling, not a technical one.</p>
      </div>

      <div class="cell">
        <div class="figure">
          <span class="glyph down">&darr;</span>
          <span class="unit">Errors</span>
        </div>
        <h3>Lower error rate</h3>
        <p>More testing, not less.</p>
      </div>

      <div class="cell">
        <div class="figure">
          <span class="glyph up">&uarr;</span>
          <span class="unit">CSAT</span>
        </div>
        <h3>Higher CSAT</h3>
        <p>The work is better, not just faster.</p>
      </div>

    </div>
  </section>

  <figcaption class="foot">
    <span class="mark">NEXT3LABS</span>
    <span>A small expert team &middot; next3labs.com</span>
  </figcaption>

</figure>
</div>
