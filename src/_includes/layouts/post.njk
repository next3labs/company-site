---
layout: layouts/base.njk
---
<section class="v3-pagehero">
  <div class="v3-wrap">
    <p class="v3-eyebrow"><a href="/blog/" style="color:inherit;text-decoration:none;">← Notes</a></p>
    <h1>{{ title }}</h1>
    <p class="v3-pagehero__lead">{{ description }}</p>
    <p style="opacity:.75;font-size:.95rem;margin-top:.75rem;">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% if readingTime %} · {{ readingTime }} min read{% endif %}
    </p>
  </div>
</section>

<section class="v3-prose">
  <div class="v3-wrap">
    {{ content | safe }}

    <hr style="margin:3rem 0 1.5rem;border:0;border-top:1px solid var(--v3-surface,#e2e2ee);">
    <p style="margin-bottom:1rem;"><strong>NEXT3LABS</strong> builds and runs high-stakes custom
    software from Singapore. We write up what actually happened on our own projects — including
    the parts that went wrong.</p>
    <p style="margin-bottom:.4rem;font-size:1.05rem;"><strong><a href="/blog/">Read the rest of
    the series →</a></strong></p>
    <p style="margin:0;opacity:.8;font-size:.95rem;">Working on something where being wrong is
    expensive? <a href="/contact/">Tell us about it.</a></p>
  </div>
</section>
