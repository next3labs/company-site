<!--
  v3 site nav. Anchor links use "/#..." so they work from any page (they jump to
  the homepage sections). Shared by every page via base.njk.
-->
<nav class="v3-nav">
  <div class="v3-wrap">
    <a class="v3-nav__brand" href="/">
      <img src="/assets/images/next3labs-logo.png" alt="NEXT3LABS logo">
      <span>NEXT3LABS</span>
    </a>
    <input type="checkbox" id="v3-nav-toggle" class="v3-nav__checkbox" aria-label="Toggle menu">
    <label for="v3-nav-toggle" class="v3-nav__burger" aria-label="Open menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </label>
    <div class="v3-nav__links">
      <a href="/#capabilities">Studio</a>
      <a href="/services/">Services</a>
      <a href="/blog/">Notes</a>
      <a href="/contact/">Contact</a>
    </div>
    <div class="v3-nav__meta">
      Location &amp; History<br>
      <strong>Singapore · since {{ site.foundingYear }}</strong>
    </div>
  </div>
</nav>
